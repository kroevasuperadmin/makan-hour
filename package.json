{
  "name": "makan-hour",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --workspace @makan/app run start",
    "build:web": "cd apps/makan-hour && npx expo export --platform web",
    "e2e": "node scripts/demo-e2e.mjs",
    "e2e:market": "node scripts/market-e2e.mjs",
    "e2e:open": "node scripts/open-demo-e2e.mjs",
    "typecheck": "cd apps/makan-hour && npx tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.0",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.0",
    "@expo-google-fonts/barlow-condensed": "^0.4.0"
  }
}