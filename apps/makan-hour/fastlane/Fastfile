# TestFlight lane for Makan Hour. Runs on GitHub Actions macOS, no EAS and no match repo.
# Signing: App Store Connect API key + imported distribution cert -> get_provisioning_profile.
default_platform(:ios)

APP_ID   = "my.makanhour.app"
WORKSPACE = "ios/MakanHour.xcworkspace"
SCHEME   = "MakanHour"
ASC_APP_ID   = ENV["ASC_APP_ID"].to_s.empty? ? "6823228464" : ENV["ASC_APP_ID"] # App Store Connect app (numeric Apple ID)
DIST_CERT_ID = ENV["DIST_CERT_ID"].to_s.empty? ? "9A4L95TSR4" : ENV["DIST_CERT_ID"] # Apple Distribution cert used by CI

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    # Expo SDK 57 needs Xcode 26.4+ (and not 27, which needs scene support on SDK 57).
    # Pick the newest installed Xcode 26.x >= 26.4, whatever the workflow's xcode-select did.
    if ENV["CI"]
      apps = Dir["/Applications/Xcode*.app"].uniq.sort
      UI.message("Installed Xcodes: #{apps.join(', ')}")
      # Skip "Xcode.app" aliases (trailing dot) and pick the newest Xcode_26.x >= 26.4.
      cand = apps.filter_map do |p|
        next unless (m = File.basename(p, ".app").match(/\AXcode_(\d+(?:\.\d+)*)\z/))
        ver = Gem::Version.new(m[1]) rescue next
        next unless ver >= Gem::Version.new("26.4") && ver < Gem::Version.new("27")
        [p, ver]
      end
      ok = cand.max_by { |_, v| v }
      UI.user_error!("No Xcode 26.4–26.x on this runner (need macos-26). Installed: #{apps.join(', ')}") unless ok
      UI.success("Selecting #{ok[0]} (#{ok[1]})")
      xcode_select(ok[0])
    end
    setup_ci # temporary keychain on CI runners

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
    team_id = ENV.fetch("APPLE_TEAM_ID")

    # Distribution certificate: created ONCE outside CI (cert id in DIST_CERT_ID) and stored as the
    # DIST_CERT_P12 / DIST_CERT_PASSWORD secrets. CI only imports it and never creates certificates,
    # so repeated runs cannot hit Apple's per-team certificate cap.
    UI.user_error!("DIST_CERT_P12 secret missing; see TESTFLIGHT.md (certificate section)") if ENV["DIST_CERT_P12_PATH"].to_s.empty?
    import_certificate(
      certificate_path: ENV["DIST_CERT_P12_PATH"],
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    # Profile is fetched or (re)created against that exact certificate. Profiles have no practical cap.
    get_provisioning_profile(api_key: api_key, team_id: team_id, app_identifier: APP_ID,
                             cert_id: DIST_CERT_ID, output_path: "build/profiles", filename: "makanhour_appstore.mobileprovision")
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: "ios/MakanHour.xcodeproj", use_automatic_signing: false, team_id: team_id,
      targets: [SCHEME], code_sign_identity: "Apple Distribution", profile_name: profile_name, bundle_identifier: APP_ID
    )

    # expo-notifications adds aps-environment at prebuild. The App Store profile has no Push capability yet,
    # and late-drop alerts are local notifications, which don't need it. Drop it until Push is enabled on the App ID.
    ent = File.expand_path("../ios/MakanHour/MakanHour.entitlements", __dir__)
    sh("/usr/libexec/PlistBuddy -c 'Delete :aps-environment' '#{ent}' || true") if File.exist?(ent)

    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID, initial_build_number: 0)
    increment_build_number(xcodeproj: "ios/MakanHour.xcodeproj", build_number: latest + 1)

    build_app(
      workspace: WORKSPACE, scheme: SCHEME, configuration: "Release", clean: true,
      export_method: "app-store", output_directory: "build", output_name: "MakanHour.ipa",
      export_options: { provisioningProfiles: { APP_ID => profile_name } },
      xcargs: "DEVELOPMENT_TEAM=#{team_id}"
    )

    upload_to_testflight(api_key: api_key, apple_id: ASC_APP_ID, ipa: "build/MakanHour.ipa", skip_waiting_for_build_processing: true,
                         changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Makan Hour demo build")
  end
end
